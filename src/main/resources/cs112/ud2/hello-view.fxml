<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs112.ud2.HelloController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <Label text="High Card" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Player name:"/>
        <TextField fx:id="playerNameField" promptText="Enter your name" prefWidth="240.0"/>
    </HBox>

    <HBox alignment="CENTER" spacing="72.0">
        <VBox alignment="CENTER" spacing="10.0">
            <Label fx:id="playerNameLabel" text="Player"/>
            <Label text="?" alignment="CENTER" prefWidth="124.0" prefHeight="150.0"
                   style="-fx-background-color: white; -fx-border-color: gray; -fx-font-size: 40;"/>
            <Label fx:id="playerScoreLabel" text="Score: 0"/>
        </VBox>
        <VBox alignment="CENTER" spacing="10.0">
            <Label text="Computer"/>
            <Label text="?" alignment="CENTER" prefWidth="124.0" prefHeight="150.0"
                   style="-fx-background-color: white; -fx-border-color: gray; -fx-font-size: 40;"/>
            <Label fx:id="computerScoreLabel" text="Score: 0"/>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" text="Enter your name and click New Game."
           alignment="CENTER" wrapText="true" minHeight="36.0" maxWidth="480.0"/>

    <HBox alignment="CENTER" spacing="16.0">
        <Button fx:id="dealButton" text="Deal" onAction="#onDeal" disable="true" prefWidth="100.0"/>
        <Button text="New Game" onAction="#onNewGame" prefWidth="100.0"/>
    </HBox>
</VBox>
